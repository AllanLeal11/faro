# Faro — environment variables
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. With MOCK_MODE=true the app runs with no keys
# at all (simulated LLM and Tavily responses).

# --- App mode ---

# true = simulate the LLM and Tavily, no API keys needed. Must be false in
# production.
MOCK_MODE=true

# development | production. Controls fail-closed checks, HSTS, /docs, etc.
ENVIRONMENT=development

# --- LLM provider ---

# bedrock | google | nebius. Selects which service the analysis pipeline
# calls. "bedrock" also satisfies the Amazon AWS Builder mini challenge;
# "google" (Gemini) needs only a free API key — no AWS, no card.
LLM_PROVIDER=bedrock

# Model ids for the two pipeline stages.
# - Bedrock: inference-profile ids from the console (e.g. a Nova or Claude
#   profile); many regions need the regional prefix (e.g. "us." / "eu.").
# - Google: a Gemini model name, e.g. a "flash" model from Google AI Studio.
# - Nebius: Nemotron model ids.
# Leave empty in MOCK_MODE.
MODEL_EXTRACT=
MODEL_VERDICT=

# --- Google Gemini (only when LLM_PROVIDER=google) ---

# Free API key from Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# --- AWS (Bedrock + SES) ---

# Region for SES (family alerts).
AWS_REGION=

# IAM user credentials. Scope to the minimum: bedrock:InvokeModel on the two
# models above, and ses:SendEmail from the verified identity. Nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region where Bedrock model access is enabled. Defaults to AWS_REGION when
# empty. Set it only if Bedrock runs in a different region than SES.
BEDROCK_REGION=

# Verified sender identity in SES (mailbox or domain).
SES_FROM_EMAIL=

# --- Nebius Token Factory (only when LLM_PROVIDER=nebius) ---

# API key and OpenAI-compatible base URL from the Token Factory console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# --- Tavily (optional evidence search) ---

# API key from the Tavily dashboard. Optional: when empty, the evidence
# stage is skipped and results are marked `partial`.
TAVILY_API_KEY=

# --- Database ---

# PostgreSQL connection string, format: postgresql://<username>:<password>@<host>:5432/faro
# Must use SSL and Railway's private network in production.
DATABASE_URL=

# --- Auth ---

# Strong random secret used to sign JWTs. Generate with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- Web / CORS ---

# Public URL of the frontend, used to build links in emails, etc.
FRONTEND_URL=

# Comma-separated list of allowed CORS origins. Never "*" with credentials.
ALLOWED_ORIGINS=

# --- MCP server (Streamable HTTP) ---

# Allow-lists for the MCP transport's DNS-rebinding protection. Set these to
# the MCP server's public host and origin in production (e.g. the Railway
# domain). Empty = localhost defaults for development.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
