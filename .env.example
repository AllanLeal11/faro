# Faro — environment variables
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. With MOCK_MODE=true the app runs with no keys
# at all (simulated LLM and Tavily responses).

# --- App mode ---

# true = simulate LLM (Nemotron) and Tavily responses, no API keys needed.
MOCK_MODE=true

# development | production. Controls fail-closed checks, HSTS, /docs, etc.
ENVIRONMENT=development

# --- Nebius Token Factory (Nemotron models) ---

# API key from the Nebius Token Factory console. Leave empty in MOCK_MODE.
NEBIUS_API_KEY=

# Base URL for the OpenAI-compatible Token Factory API.
# Confirmed from https://github.com/nebius/token-factory-cookbook (2026-09-21):
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model id used for fast extraction (extract.py). CLAUDE.md calls this
# "Nemotron Nano", but as of 2026-09-21 that model is listed as not
# currently available on Token Factory (see models/nemotron/README.md in
# the cookbook above). The current fast/cheap Nemotron on the catalog is:
#   nvidia/Nemotron-3_5-Lightning
# Re-check the catalog before filling this in — it may change by launch.
MODEL_EXTRACT=

# Model id used for the reasoning verdict step (verdict.py). CLAUDE.md
# calls this "Nemotron Super"; as of 2026-09-21 the catalog has:
#   nvidia/nemotron-3-super-120b-a12b
MODEL_VERDICT=

# --- Tavily (evidence search) ---

# API key from the Tavily dashboard. Leave empty in MOCK_MODE.
TAVILY_API_KEY=

# --- Database ---

# PostgreSQL connection string, format: postgresql://<username>:<password>@<host>:5432/faro
# Must use SSL and Railway's private network in production.
DATABASE_URL=

# --- Auth ---

# Strong random secret used to sign JWTs. Generate with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- Amazon SES (family alerts) ---

AWS_REGION=

# IAM user credentials scoped to ses:SendEmail only, from the verified
# identity used to send alerts.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Verified sender identity in SES (mailbox or domain).
SES_FROM_EMAIL=

# --- Web / CORS ---

# Public URL of the frontend, used to build links in emails, etc.
FRONTEND_URL=

# Comma-separated list of allowed CORS origins. Never "*" with credentials.
ALLOWED_ORIGINS=
