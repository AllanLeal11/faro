# Normalize everything to LF in the repo and in the working tree.
* text=auto eol=lf

# Windows-only scripts that break with LF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary

# Lock files: keep them out of noisy diffs
uv.lock -diff linguist-generated
package-lock.json -diff linguist-generated
